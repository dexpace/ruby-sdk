# Dexpace::Transport::NetHTTP::RequestMapper is a private_constant and not public API: this
# declaration exists because the `net_http` Steep target checks every file under lib/ and needs
# the module and its one function declared to type Adapter's call site. RBS has no visibility for
# a constant, so the privacy lives in lib/dexpace/transport/net_http/request_mapper.rb alone. The
# native request is untyped: nothing from net/http may name a signature (NFR-11).
module Dexpace
  module Transport
    module NetHTTP
      module RequestMapper
        AUTO_STAMPS: Array[String]

        def self?.build: (untyped request, logger: Instrumentation::Logger) -> untyped

        private

        def native_request: (untyped request, bool body_permitted) -> untyped
        def revalidate!: (untyped request) -> void
        def copy_headers: (untyped request, untyped native, Instrumentation::Logger logger) -> void
        def suppress_decode_content: (untyped native) -> void
        def set_content_type: (untyped request, untyped native, bool body_permitted) -> void
        def attach_body: (untyped request, untyped native, bool body_permitted) -> void
        def log_drop: (Instrumentation::Logger logger, String name) -> nil
      end
    end
  end
end
