# Dexpace::Transport::NetHTTP::Failures is a private_constant and not public API: this declaration
# exists because the `net_http` Steep target checks every file under lib/ and needs the module and
# its one function declared to type Adapter's and ResponsePump's call sites. RBS has no visibility
# for a constant, so the privacy lives in lib/dexpace/transport/net_http/failures.rb alone.
module Dexpace
  module Transport
    module NetHTTP
      module Failures
        def self?.wrap: (Exception error, phase: Symbol, cancellation: Dexpace::Cancellation) -> Exception

        private

        def own?: (Exception error) -> bool
      end
    end
  end
end
