module Dexpace
  module Recovery
    class IdempotencyKeyStep
      include Transform

      # Both private_constants, declared so Steep can type the default parameter and the check.
      DEFAULT_METHODS: Array[Dexpace::Method]
      MODES: Array[Symbol]

      attr_reader header: String
      attr_reader strategy: ^(Dexpace::Request) -> String
      attr_reader methods: Array[Dexpace::Method]
      attr_reader mode: Symbol

      private def self.new: (
        header: String,
        strategy: ^(Dexpace::Request) -> String,
        methods: Array[Dexpace::Method],
        mode: Symbol
      ) -> instance
      def initialize: (
        header: String,
        strategy: ^(Dexpace::Request) -> String,
        methods: Array[Dexpace::Method],
        mode: Symbol
      ) -> void

      def self.build: (
        header: String,
        strategy: ^(Dexpace::Request) -> String,
        ?methods: Array[Dexpace::Method],
        ?mode: Symbol
      ) -> IdempotencyKeyStep

      def phase: () -> :request
      def apply: (Dexpace::Request request) -> Dexpace::Request
    end
  end
end
