module Dexpace
  # TRANSPORT-20 and XCUT-4 branch (b): the always-retryable transport failure, a sibling of
  # StreamError inside ::IOError (P3-3). Phase 8's phase-level task, landed by 8a.
  class TransportError < ::IOError
    include Dexpace::Error

    attr_reader phase: Symbol?

    def initialize: (?String message, ?phase: Symbol?) -> void
    def retryable?: () -> true
  end
end
