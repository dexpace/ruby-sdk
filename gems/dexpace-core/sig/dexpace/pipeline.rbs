module Dexpace
  class Pipeline
    include Dexpace::Closeable

    @entries: Array[Entry]
    @steps: Array[untyped]
    @transport: untyped
    @driver_class: untyped

    attr_reader entries: Array[Entry]
    attr_reader steps: Array[untyped]
    attr_reader transport: untyped

    # .new is private and driver_class: is an argument only Builder can supply, so neither is
    # public surface NFR-4 locks.
    private def self.new: (entries: Array[Entry], transport: untyped, driver_class: untyped) -> instance
    def initialize: (entries: Array[Entry], transport: untyped, driver_class: untyped) -> void

    def self.builder: (transport: untyped) -> Builder
    def self.direct: (untyped transport) -> Pipeline
    def self.standard: (untyped over, ?redirect: Redirect::Step?, ?settings: Resilience::RetrySettings,
                        ?http_tracer_factory: untyped, ?logger: Instrumentation::Logger,
                        ?level: Instrumentation::HTTPLogging, ?preview_bytes: Integer?) -> Pipeline

    def call: (Dexpace::Request request, ?Dexpace::RequestOptions options, ?Dexpace::Cancellation cancellation, ?bundle: Instrumentation::Bundle) -> Dexpace::Response

    private

    def self.standard_redirect: (untyped redirect, Instrumentation::Logger logger) -> Redirect::Step
  end
end
