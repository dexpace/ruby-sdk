module Dexpace
  module Async
    # Async::Deadline is a private_constant and not public API: declared because the strict
    # `core` Steep target types its one call site.
    module Deadline
      def self?.validate: (untyped deadline, untyped clock) -> Float?
      def self?.expired?: (Thread::Queue gate, Float? limit, _Clock clock) { () -> bool } -> bool
    end

    class Completer
      # The two callback lists #settle steals under the lock, as one tuple.
      type stolen = [Array[^(Dexpace::Async::Settlement) -> void], Array[^(untyped) -> void]]

      @mutex: Thread::Mutex
      @gate: Thread::Queue
      @outcome: Dexpace::Async::Settlement?
      @on_settle: Array[^(Dexpace::Async::Settlement) -> void]
      @on_cancel: Array[^(untyped) -> void]
      @future: Dexpace::Async::Future?

      attr_reader outcome: Dexpace::Async::Settlement?

      def initialize: () -> void
      def future: () -> Dexpace::Async::Future
      def settled?: () -> bool
      def fulfil: (untyped response) -> bool
      def fail: (Exception error) -> bool
      def request_cancel: (?untyped reason) -> bool
      def on_cancel: () { (untyped) -> void } -> self
      def on_settle: () { (Dexpace::Async::Settlement) -> void } -> self
      # -> self, unchanged from phase 2; deadline: and clock: widen it (phase 5a).
      def await: (?Dexpace::Cancellation? cancellation, ?deadline: Numeric?, ?clock: _Clock) -> self

      private

      def cancel_reason: (Dexpace::Async::Settlement settlement) -> untyped
      def arm: (Dexpace::Cancellation? cancellation) -> Dexpace::Cancellation::Subscription?
      def settle: (Dexpace::Async::Settlement settlement) -> bool
    end
  end
end
