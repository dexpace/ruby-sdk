module Dexpace
  module URL
    def self?.parse!: (String | URI::Generic input) -> URI::Generic
    def self?.external_form: (URI::Generic uri) -> String
    def self?.resolve: (String | URI::Generic base, String reference) -> URI::Generic?

    private

    def own: (URI::Generic uri) -> URI::Generic
    def string_or_uri!: (untyped input) -> void
    def refuse_hostless!: (URI::Generic uri, String | URI::Generic input) -> void
    def renderable!: (URI::Generic uri, String | URI::Generic input) -> URI::Generic
  end
end
