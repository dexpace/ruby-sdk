module Dexpace
  class MediaType < Data
    include Model

    PSEUDO_CHARSETS: Array[String]
    KNOWN_CHARSETS: Array[String]
    UNTIL_SEPARATOR: Regexp
    SEPARATOR: Regexp
    KEY: Regexp
    QUOTED: Regexp
    QUOTED_PAIR: Regexp
    TO_ESCAPE: Regexp

    attr_reader type: String
    attr_reader subtype: String
    attr_reader parameters: Hash[String, String]

    private def self.new: (type: String, subtype: String, parameters: Hash[String, String]) -> instance
    def initialize: (type: String, subtype: String, parameters: Hash[String, String]) -> void

    def self.build: (type: String, subtype: String, ?parameters: Hash[String, String]) -> MediaType
    def self.parse: (String text) -> MediaType
    private def self.parse_essence: (StringScanner scanner) -> [String, String]
    private def self.parse_parameter: (StringScanner scanner) -> [String, String]
    private def self.parse_key: (StringScanner scanner) -> String
    private def self.parse_value: (StringScanner scanner) -> String
    private def self.malformed!: (StringScanner scanner, ?String what) -> bot

    def charset: () -> String?
    def render: () -> String
    def to_s: () -> String
    def matches?: (MediaType other) -> bool

    private

    def quote: (String value) -> String
    def validate_component!: (String name, untyped value) -> void
    def validate_parameters!: (untyped parameters) -> void
  end
end
