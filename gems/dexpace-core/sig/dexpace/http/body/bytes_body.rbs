module Dexpace
  class BytesBody
    include Dexpace::Body

    attr_reader media_type: Dexpace::MediaType?

    def initialize: (String bytes, ?media_type: Dexpace::MediaType?) -> void
    def content_length: () -> Integer
    def replayable?: () -> bool
    def write_to: (Dexpace::IO::_Sink sink) -> Integer
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer

    private

    @bytes: String

    # #== reads the other body's bytes through it with `send`, as Headers#== reaches #values.
    def bytes: () -> String
  end
end
