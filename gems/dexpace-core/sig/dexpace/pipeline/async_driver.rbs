# Dexpace::Pipeline::AsyncDriver is a private_constant and not public API (design P2-15): this
# declaration exists because the strict `core` Steep target checks every file under lib/ and
# needs the class and its methods declared to type its call sites in Cursor, Builder and
# AsyncPipeline. RBS has no visibility for a constant, so the privacy lives in
# lib/dexpace/pipeline/async_driver.rb alone.
module Dexpace
  class Pipeline
    class AsyncDriver
      @pipeline: AsyncPipeline

      def initialize: (AsyncPipeline pipeline) -> void
      def entry_at: (Integer index) -> Entry
      def advance: (position: Integer, request: Dexpace::Request, options: Dexpace::RequestOptions, cancellation: Dexpace::Cancellation, state: Hash[Stage, Hash[untyped, untyped]]) -> Dexpace::Async::Future
      def dispatch: (Dexpace::Request request, Dexpace::RequestOptions options, Dexpace::Cancellation cancellation) -> Dexpace::Async::Future

      private

      def normalise: (terminal: bool) { () -> untyped } -> Dexpace::Async::Future
      def failed: (::Exception error) -> Dexpace::Async::Future
    end
  end
end
