module Dexpace
  module Auth
    # AUTH-14: Basic, preemptive through #call and challenge-answered through
    # #authorization_for, one precomputed value.
    class BasicHandler
      @value: String

      def initialize: (PasswordCredential credential) -> void

      def call: (Dexpace::Request request) -> Dexpace::Request
      def authorization_for: (Array[Challenge] challenges, Dexpace::Request _request,
                              ?proxy: bool) -> String?
    end
  end
end
