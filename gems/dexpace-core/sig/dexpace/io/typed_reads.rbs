module Dexpace
  module IO
    module TypedReads
      # Three private_constants with no visibility in RBS, declared so Steep can type the store.
      NEWLINE: String
      CARRIAGE_RETURN: String
      READ_SEGMENT_BYTES: Integer

      def initialize_typed_reads: () -> nil
      def read_into: (String dest, count: Integer) -> Integer
      def read: (?Integer? length, ?String? outbuf) -> String?
      def readpartial: (Integer maxlen, ?String? outbuf) -> String
      def read_exactly: (Integer count) -> String
      def getbyte: () -> Integer?
      def readbyte: () -> Integer
      def read_utf8: (?count: Integer?) -> String
      def read_string: (Encoding | String encoding, ?count: Integer?) -> String
      def read_line_utf8: () -> String?
      def skip: (Integer count) -> nil
      def eof?: () -> bool
      def each: () { (String) -> void } -> nil
              | () -> Enumerator[String, nil]
      def peek: () -> Dexpace::IO::BufferedSource
      def slice: (offset: Integer, count: Integer) -> Dexpace::IO::BufferedSource

      # The view protocol: protected in lib/, so a view drives its parent and nothing else may.
      def dexpace_consumed: () -> Integer
      def dexpace_fill_beyond: (Integer behind, Integer want) -> Integer
      def dexpace_window_copy: (Integer offset, Integer count) -> String
      def dexpace_register_view: (Dexpace::IO::TypedReads view) -> nil
      def dexpace_forget_view: (Dexpace::IO::TypedReads view) -> nil
      def dexpace_invalidate: () -> nil
      def dexpace_release_views: () -> nil
      def dexpace_remaining_window: () -> Integer?

      private

      # Prefixed so an including class's own state cannot collide with the store.
      @dexpace_chunks: Array[String]
      @dexpace_head: Integer
      @dexpace_buffered: Integer
      @dexpace_consumed: Integer
      @dexpace_views: Array[Dexpace::IO::TypedReads]
      @dexpace_invalidated: bool

      # The one hook an includer supplies.
      def fill: (Integer min_bytes) -> Integer

      # Closeable's, which an includer must also include (asserted at #initialize_typed_reads).
      def closed?: () -> bool

      def ensure_readable: () -> void
      def reads_survive_close?: () -> bool
      def ensure_typed_reads_initialized: () -> void
      def fill_once_if_empty: (?Integer min_bytes) -> Integer
      def ensure_buffered: (Integer target) -> Integer
      def store_append: (String? chunk) -> Integer
      def store_take: (Integer count) -> String
      def take_from_head: (Integer count) -> String
      def store_take_chunk: () -> String?
      def store_drop: (Integer count) -> nil
      def advance_head: (Integer taken, Integer available) -> nil
      def store_peek: (Integer offset, Integer count) -> String
      def store_index_of: (String byte, Integer from) -> Integer?
      def finish_line: (String bytes, terminated: bool) -> String
      def drain_all: () -> String
      def read_up_to: (Integer length) -> String?
      def materialization_hint: () -> Integer?
      def guard_materialization!: (Integer? count) -> void
      def resolve_encoding: (Encoding | String encoding) -> Encoding
      def build_view: (offset: Integer, window: Integer?) -> Dexpace::IO::BufferedSource
      def validate_count!: (untyped value, name: String) -> void
      def validate_destination!: (untyped dest) -> void
      def raise_end_of_stream: (String operation) -> bot
    end
  end
end
