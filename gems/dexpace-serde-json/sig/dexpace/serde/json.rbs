module Dexpace
  module Serde
    # The reference wire codec over Ruby's json: the floor it asserts (P7-7), the core constraint
    # it registers against, and the two factories.
    module JSON
      MINIMUM_JSON_VERSION: String
      REQUIRED_CORE: String

      def self.default: () -> Codec
      def self.build: (?Hash[Symbol, untyped]? options) -> Codec
    end
  end
end
