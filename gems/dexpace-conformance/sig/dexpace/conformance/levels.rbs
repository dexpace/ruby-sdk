module Dexpace
  module Conformance
    # Generated from appendix C by tools/requirement_levels.rb; what lets a Report tell a
    # MUST-level vacuity from a SHOULD-level one (design R3).
    module Levels
      OF: Hash[String, Symbol]

      def self.known?: (String id) -> bool
      def self.of: (String id) -> Symbol
      def self.must?: (String id) -> bool
    end
  end
end
