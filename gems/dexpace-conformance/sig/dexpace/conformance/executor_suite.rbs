# SPDX-License-Identifier: MIT

module Dexpace
  module Conformance
    # Appendix B.7's lifecycle half, and the harness half of SEAM-25's lifecycle event.
    module ExecutorSuite
      PREAMBLE: String
      # A private_constant with no visibility in RBS; the two groups, concatenated.
      ASSERTIONS: Array[Assertion]

      def self?.assertions: () -> Array[Assertion]
      def self?.run: (build: untyped, ?borrow: untyped, ?functional: untyped,
                      ?record_events: bool, ?waive: Array[String], ?around: untyped,
                      ?accepted_vacuous: Hash[String, String],
                      ?would_fail: Array[String]) -> Report
    end
  end
end
