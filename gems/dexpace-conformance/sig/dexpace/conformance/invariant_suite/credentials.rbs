# Dexpace::Conformance::InvariantSuite::Credentials is a private_constant (see credentials.rb);
# declared because the conformance Steep target checks every file under lib/.
module Dexpace
  module Conformance
    module InvariantSuite
      module Credentials
        ORIGIN_SCOPED: Array[String]
        SEED: String
        ENTROPY_BYTES: Integer
        KEYWORD_KINDS: Array[Symbol]
        MAX_PROBED: Integer
        ROWS: Array[untyped]
        ASSERTIONS: Array[Assertion]

        def self?.redirect_credential_hygiene: (InvariantCase subject) -> nil
        def self?.check_cross_origin: (InvariantCase subject) -> void
        def self?.check_userinfo: (InvariantCase subject) -> nil
        def self?.check_downgrade: (InvariantCase subject) -> nil
        def self?.csprng_for_security_values: (InvariantCase subject) -> nil
        def self?.injectable?: (untyped handler) -> bool
        def self?.check_entropy: (InvariantCase subject) -> nil

        # `include ::Random::Formatter` is deliberately NOT declared: gates:rbs_surface refuses
        # any constant outside Dexpace:: and its stdlib allowlist in a shipped signature, and
        # widening that allowlist for a test double would be lowering a gate to make the tree
        # pass. Nothing in this gem calls a Formatter method on a Recorder -- the SUBJECT does.
        class Recorder
          @flip: Integer?
          @drawn: Integer

          attr_reader drawn: Integer

          def initialize: (?Integer? flip) -> void
          def bytes: (Integer count) -> String
        end
      end
    end
  end
end
